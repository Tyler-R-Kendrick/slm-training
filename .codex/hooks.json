{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m scripts.repo_policy --pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/validate_page_dsl.py --changed"
          },
          {
            "type": "command",
            "command": "python3 -m scripts.verify_version_stamps --post-tool-use"
          },
          {
            "type": "command",
            "command": "python3 -m scripts.refresh_test_cases --check --changed"
          }
        ]
      }
    ]
  }
}
