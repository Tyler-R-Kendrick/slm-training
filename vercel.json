{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv pip install --python .vercel/python/.venv/bin/python -r src/slm_training/web/requirements-vercel.txt || pip install -r src/slm_training/web/requirements-vercel.txt",
  "functions": {
    "src/slm_training/web/vercel.py": {
      "maxDuration": 180,
      "includeFiles": "{docs/design/*.json,docs/MODEL_CARD.md,src/slm_training/resources/checkpoints/playground_demo/**}",
      "excludeFiles": "{{.venv,.vercel,node_modules,outputs,tests,src/apps}/**,docs/design/{*-agentv-*/**,iter-slm200-*.json},**/governance/records.jsonl,src/slm_training/{flow/{samplers,targets}.py,harnesses/experiments/**,models/legal_edit_flow.py}}"
    }
  }
}
