{
  "schema": "test_cases/v1",
  "module": "tests/test_evals/test_meaningful_program.py",
  "case_sets": {
    "test_v2_rejects_known_dynamic_schema_role_mismatch": {
      "parameters": [
        "source"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "items = Query(\"q\", {}, {rows: []})\nroot = Button(@Count(items.rows))"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "items = Query(\"q\", {}, {rows: []})\nroot = Stack(@Count(items.rows))"
          ]
        }
      ]
    },
    "test_v2_rejects_unreachable_runtime_or_state_bindings": {
      "parameters": [
        "source"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "unused = Query(\"q\", {}, {})\nroot = Button(\":cta.label\")"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "$a = $b\n$b = $a\nroot = Button(\":cta.label\")"
          ]
        }
      ]
    },
    "test_v2_excludes_replaced_or_negated_components": {
      "parameters": [
        "prompt"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "Replace the Button with a Card. Placeholders: :hero.title"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "Build a Card without a Button. Placeholders: :hero.title"
          ]
        },
        {
          "id": "case-003",
          "values": [
            "Build a Button-free Card. Placeholders: :hero.title"
          ]
        }
      ]
    },
    "test_meaningful_program_v1_backward_lock": {
      "parameters": [
        "source",
        "reason"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "root = Stack([])",
            "empty_root_stack"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "root = Card([])",
            "empty_card"
          ]
        },
        {
          "id": "case-003",
          "values": [
            "root = Stack([x])\nx = TextContent(\":x\")",
            null
          ]
        },
        {
          "id": "case-004",
          "values": [
            "root = Separator()",
            "no_placeholders"
          ]
        }
      ]
    },
    "test_meaningful_program_v1_catches_padded_empty_children": {
      "parameters": [
        "source",
        "reason"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "root = Card([], \":stuffed.variant\")",
            "empty_card"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "root = Card([], \":ood.dash.m1.value\", \":ood.dash.m1.value\")",
            "empty_card"
          ]
        },
        {
          "id": "case-003",
          "values": [
            "root = Stack([v0, v1], \"column\")\nv0 = Card([TextContent(\":a\")])\nv1 = Card([], \":stuffed.variant\")",
            "empty_card"
          ]
        },
        {
          "id": "case-004",
          "values": [
            "root = Modal(\":title\", true, [])",
            "empty_children:Modal"
          ]
        },
        {
          "id": "case-005",
          "values": [
            "root = Carousel([])",
            "empty_children:Carousel"
          ]
        }
      ]
    },
    "test_meaningful_program_v1_still_accepts_genuinely_nonempty_components": {
      "parameters": [
        "source"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            "root = Card([TextContent(\":a\")], \":real.variant\")"
          ]
        },
        {
          "id": "case-002",
          "values": [
            "root = Stack([Card([TextContent(\":a\")])], \"column\")"
          ]
        }
      ]
    }
  }
}
