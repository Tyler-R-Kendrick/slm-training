{
  "schema": "test_cases/v1",
  "module": "tests/test_scripts/test_supervisor_adversary.py",
  "case_sets": {
    "test_controller_git_mutations_refuse_before_process_launch": {
      "parameters": [
        "argv"
      ],
      "cases": [
        {
          "id": "case-001",
          "values": [
            [
              "git",
              "commit",
              "-m",
              "self-heal"
            ]
          ]
        },
        {
          "id": "case-002",
          "values": [
            [
              "git",
              "merge",
              "--abort"
            ]
          ]
        },
        {
          "id": "case-003",
          "values": [
            [
              "git",
              "restore",
              "--staged",
              "human.py"
            ]
          ]
        },
        {
          "id": "case-004",
          "values": [
            [
              "git",
              "fetch",
              "origin",
              "main"
            ]
          ]
        },
        {
          "id": "case-005",
          "values": [
            [
              "/usr/bin/git",
              "checkout",
              "--theirs",
              "human.py"
            ]
          ]
        },
        {
          "id": "case-006",
          "values": [
            [
              "git",
              "-c",
              "alias.fix=!false",
              "fix"
            ]
          ]
        },
        {
          "id": "case-007",
          "values": [
            [
              "git",
              "diff",
              "--output=human.py"
            ]
          ]
        }
      ]
    }
  }
}
