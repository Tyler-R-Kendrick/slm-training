    "Timeout or skipped optional dependency is never false success and never a semantic refutation.",
    "Physical performance measurements stay empirical and are out of scope for this abstract-proof matrix."
  ],
  "skip_semantics": {
    "skipped_optional": "optional tool unavailable; reported, not counted toward release.passed",
    "timeout_required": "required gate wall-budget exceeded; counts as failure (never evidence)",
    "timeout_optional": "optional probe timed out; status skipped_optional_timeout, not ok and not refutation",
    "research_default_off": "research/pilot arm; visible in summary; not required for infrastructure release",
    "delegated": "owned by merge_ready / CI job already executing the same CLI; identity certified here"
  },
