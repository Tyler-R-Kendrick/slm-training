{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource_bound_trigger_parity.schema.json",
  "title": "Resource bound and trigger parity fixtures (KERN-10 / SLM-538)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issue", "kern", "wall_clock_claim", "cases"],
  "properties": {
    "schema": {
      "const": "resource_bound_trigger_parity/v1"
    },
    "issue": {
      "const": "SLM-538"
    },
    "kern": {
      "const": "KERN-10"
    },
    "wall_clock_claim": {
      "const": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "exactInt": {
      "type": "integer"
    },
    "exactRationalString": {
      "type": "string",
      "pattern": "^-?[0-9]+(/[0-9]+)?$"
    },
    "computabilityLabel": {
      "type": "string",
      "enum": [
        "finite_decidable",
        "primitive_recursive",
        "bounded_search",
        "total_recursive",
        "semidecidable",
        "co_semidecidable",
        "oracle_relative",
        "classical_propositional",
        "noncomputable_existence",
        "classical_noncomputable_existence",
        "unclassified"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "status", "inputs", "expect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": [
            "finite_search",
            "black_box",
            "closure",
            "event_trace",
            "singleton",
            "mechanism_trigger",
            "bound_ast",
            "judgment",
            "computability",
            "adversarial"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["supported", "unsupported"]
        },
        "unsupported_reason": {
          "type": ["string", "null"]
        },
        "lean_module": {
          "type": ["string", "null"]
        },
        "lean_theorem": {
          "type": ["string", "null"]
        },
        "model_id": {
          "type": ["string", "null"]
        },
        "inputs": {
          "type": "object"
        },
        "expect": {
          "type": "object",
          "description": "Canonical exact integers/rationals/bools/labels for supported cases."
        }
      }
    }
  }
}
