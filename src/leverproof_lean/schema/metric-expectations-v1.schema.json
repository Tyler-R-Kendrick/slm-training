{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeverProof preregistered metric expectations v1",
  "type": "object",
  "required": ["schema", "metrics"],
  "properties": {
    "schema": {"const": "metric_expectations/v1"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "unit", "authority", "dependencies", "program"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "authority": {"enum": ["theorem", "assumption_backed"]},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"$ref": "#/$defs/interval"}
              },
              "additionalProperties": false
            }
          },
          "program": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op"],
              "properties": {
                "op": {
                  "enum": [
                    "constant",
                    "variable",
                    "add",
                    "multiply",
                    "power",
                    "inverse"
                  ]
                },
                "value": {"$ref": "#/$defs/ratio"},
                "name": {"type": "string", "minLength": 1},
                "exponent": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/ratio"},
        "upper": {"$ref": "#/$defs/ratio"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
