{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeverProof metric evidence v2",
  "type": "object",
  "required": ["schema", "run_id", "source", "workload", "candidates", "expectations"],
  "properties": {
    "schema": {"const": "metric_evidence/v2"},
    "run_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["evidence_sha256", "feature_flags_sha256", "metric_expectations_sha256"],
      "properties": {
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "feature_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "campaign_manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "metric_expectations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "workload": {"$ref": "metric-evidence-v1.schema.json#/properties/workload"},
    "candidates": {"$ref": "metric-evidence-v1.schema.json#/properties/candidates"},
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "unit", "authority", "dependencies", "program", "observations"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "authority": {"enum": ["theorem", "assumption_backed"]},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"$ref": "#/$defs/interval"}
              },
              "additionalProperties": false
            }
          },
          "program": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op"],
              "properties": {
                "op": {"enum": ["constant", "variable", "add", "multiply", "power", "inverse"]},
                "value": {"$ref": "#/$defs/ratio"},
                "name": {"type": "string", "minLength": 1},
                "exponent": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "observations": {"$ref": "#/$defs/samples"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/ratio"},
        "upper": {"$ref": "#/$defs/ratio"}
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
