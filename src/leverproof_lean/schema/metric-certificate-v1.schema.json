{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TKendrick/leverproof-lean/schema/metric-certificate-v1.schema.json",
  "title": "LeverProof Lean metric certificate v1",
  "type": "object",
  "required": [
    "schema", "checker", "verified", "assurance", "run_id",
    "evidence_sha256", "feature_flags_sha256", "selected_candidate",
    "candidates", "trusted_boundary"
  ],
  "properties": {
    "schema": {"const": "metric_certificate/v1"},
    "checker": {"const": "leverproof-lean/v1"},
    "verified": {"const": true},
    "assurance": {"const": "observed_raw_samples"},
    "run_id": {"type": "string"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_candidate": {"type": "string"},
    "candidates": {"type": "array", "minItems": 1},
    "trusted_boundary": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
