{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeverProof metric certificate v2",
  "type": "object",
  "required": [
    "schema",
    "checker",
    "verified",
    "assurance",
    "run_id",
    "evidence_sha256",
    "feature_flags_sha256",
    "metric_expectations_sha256",
    "selected_candidate",
    "candidates",
    "assessments",
    "trusted_boundary"
  ],
  "properties": {
    "schema": {"const": "metric_certificate/v2"},
    "checker": {"const": "leverproof-lean/v2"},
    "verified": {"const": true},
    "assurance": {"const": "calculated_bands_and_observed_raw_samples"},
    "run_id": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric_expectations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_candidate": {"type": "string", "minLength": 1},
    "candidates": {"type": "array", "minItems": 1},
    "assessments": {"type": "array", "minItems": 1},
    "trusted_boundary": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
